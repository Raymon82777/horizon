# Your Apple signing settings for the iOS app. Copy this file to ios/signing.env (git ignores it)
# and fill it in; every ios/ script reads it. Values you export in the shell win over the file.
# How to find each value: ios/README.md, "Set up signing".

# Your Apple developer Team ID: 10 letters and digits (Xcode → Settings → Accounts → your team).
HORIZON_IOS_TEAM=ABCDE12345

# A bundle ID of your own, reverse-DNS: no one else's (an ID belongs to one team).
HORIZON_IOS_BUNDLE_ID=com.example.horizon

# 1 with a paid Apple Developer Program membership: the app asks iOS for more memory (Increased
# Memory Limit, Extended Virtual Addressing). 0 with a free Apple account, which can't have those:
# the app builds and runs without them, with less memory (keep the render distance low).
HORIZON_IOS_PAID=1

# Optional: the iPhone or iPad to install on by default (its UDID: xcrun devicectl list devices).
# HORIZON_IOS_DEVICE=

# Only for ios/package.sh (the old spike path): your Apple Development identity's SHA-1
# (security find-identity -v -p codesigning).
# HORIZON_IOS_IDENTITY=

# Optional: the fork's address for the app's About section (default: the remote your branch tracks).
# HORIZON_SOURCE_URL=https://github.com/you/horizon-ios
