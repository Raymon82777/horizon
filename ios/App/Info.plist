<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>HorizonSourceURL</key>
	<string>$(HORIZON_SOURCE_URL)</string>
	<key>HorizonBuildHost</key>
	<string>$(HORIZON_BUILD_HOST)</string>
	<key>HorizonBuildLocal</key>
	<string>$(HORIZON_BUILD_LOCAL)</string>
	<key>HorizonBuildToken</key>
	<string>$(HORIZON_BUILD_TOKEN)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Horizon asks your Mac on this network to build your native mods, without going through Tailscale.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
